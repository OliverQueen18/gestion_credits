# Variables lues par docker compose (préfixe DOCKER_ pour ne pas
# écraser le .env local WAMP).

DOCKER_APP_PORT=8080
DOCKER_APP_URL=http://localhost:8080
DOCKER_APP_DEBUG=false
DOCKER_APP_KEY=
DOCKER_LOG_LEVEL=info

DOCKER_DB_DATABASE=gestion_credit
DOCKER_DB_USERNAME=gestion
DOCKER_DB_PASSWORD=changeme_docker
DOCKER_DB_ROOT_PASSWORD=changeme_root
